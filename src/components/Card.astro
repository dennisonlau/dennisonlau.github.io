---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";
import BookCover from "./BookCover.astro";
import BookRating from "./BookRating.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;
const { title, description, book } = data;
---

<li class="writing-card">
  {book && <BookCover book={book} />}

  <div class="writing-content">
    <div class="writing-heading">
      <a
        href={getPostUrl(id, filePath, Astro.currentLocale)}
        class="text-accent text-lg font-medium underline-offset-4 hover:underline"
      >
        <Heading transition:name={toTransitionName(id)}>
          {title}
        </Heading>
      </a>

      {
        book?.status === "finished" && book.rating !== undefined && (
          <BookRating rating={book.rating} />
        )
      }
    </div>

    {book && <p class="book-author">{book.author}</p>}

    <Datetime {...data} />

    <p class="writing-description">{description}</p>
  </div>
</li>

<style>
  .writing-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-block: 1.75rem;
  }

  .writing-content {
    flex: 1;
    min-width: 0;
  }

  .writing-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .writing-heading > a {
    min-width: 0;
  }

  .book-author {
    margin-block: 0.15rem 0.25rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .writing-description {
    margin-top: 0.4rem;
    line-height: 1.65;
  }
</style>
