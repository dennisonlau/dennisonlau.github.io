---
interface Props {
  book: {
    cover?: string;
    isbn?: string;
  };
  size?: number;
}

const { book, size = 48 } = Astro.props;

const src =
  book.cover ??
  (book.isbn
    ? `https://covers.openlibrary.org/b/isbn/${book.isbn}-M.jpg?default=false`
    : undefined);
---

<div
  class="book-cover"
  style={`--cover-width: ${size}px`}
  aria-hidden="true"
>
  {
    src && (
      <img
        src={src}
        alt=""
        width="100"
        height="150"
        loading="lazy"
        decoding="async"
        onerror="this.style.visibility='hidden'"
      />
    )
  }
</div>

<style>
  .book-cover {
    width: var(--cover-width);
    aspect-ratio: 2 / 3;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 3px;
    background: color-mix(
      in srgb,
      var(--foreground) 8%,
      var(--background)
    );
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
