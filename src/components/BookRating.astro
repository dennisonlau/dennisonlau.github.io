---
interface Props {
  rating: number;
}

const { rating } = Astro.props;
const score = Math.min(10, Math.max(0, rating));
---

<span
  class="book-rating"
  role="img"
  aria-label={`My rating: ${score} out of 10`}
  title={`My rating: ${score}/10`}
>
  <svg viewBox="0 0 40 40" aria-hidden="true">
    <circle class="track" cx="20" cy="20" r="16" />
    <circle
      class="progress"
      cx="20"
      cy="20"
      r="16"
      pathLength="100"
      stroke-dasharray={`${score * 10} 100`}
      transform="rotate(-90 20 20)"
    />
  </svg>
  <span aria-hidden="true">{score}</span>
</span>

<style>
  .book-rating {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    color: #087f5b;
    vertical-align: middle;
  }

  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke-width: 3;
  }

  .track {
    stroke: currentColor;
    opacity: 0.16;
  }

  .progress {
    stroke: currentColor;
  }

  .book-rating > span {
    font-size: 0.85rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  :global([data-theme="dark"]) .book-rating {
    color: #6ee7b7;
  }
</style>
