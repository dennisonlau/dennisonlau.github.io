---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
  <section id="hero" class="home-intro" aria-labelledby="intro-title">
    <p class="home-eyebrow">Engineering, books &amp; ideas</p>
  
    <h1 id="intro-title">
      Thinking<br />things through.
    </h1>
  
    <p class="home-description">
      I write to understand what I read, question assumptions,
      and connect ideas to life and work.
    </p>
  
    <a class="home-about" href={getRelativeLocaleUrl(locale, "about")}>
      More about me <span aria-hidden="true">↗</span>
    </a>
  </section>
  
  <nav class="home-paths" aria-label="Explore my writing">
    <a class="home-path" href={getRelativeLocaleUrl(locale, "bookshelf")}>
      <span class="home-path-label">Reading notes</span>
      <h2>Bookshelf <span aria-hidden="true">↗</span></h2>
      <p>
        What stayed with me, what changed my mind, and where I disagree.
      </p>
    </a>
  
    <a class="home-path" href={getRelativeLocaleUrl(locale, "essays")}>
      <span class="home-path-label">Beyond the bookshelf</span>
      <h2>Essays <span aria-hidden="true">↗</span></h2>
      <p>
        Questions and reflections on technology, work, and learning.
      </p>
    </a>
  </nav>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            Latest writing
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>
<style>
  .home-intro {
    padding-block: clamp(2.5rem, 6vw, 4rem) 2.5rem;
  }

  .home-eyebrow,
  .home-path-label {
    color: var(--muted-foreground);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .home-intro h1 {
    margin-block: 1rem 1.25rem;
    font-size: clamp(2.125rem, 6vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.16;
  }

  .home-description {
    max-width: 52ch;
    font-size: 1.0625rem;
    text-wrap: balance;
    line-height: 1.75;
  }

  .home-about {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.125rem;
    padding-block: 0.25rem;
    color: var(--accent);
    font-size: 0.875rem;
    text-underline-offset: 0.25em;
  }

  .home-about:hover {
    text-decoration: underline;
  }

  .home-paths {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block: 1px solid var(--border);
  }

  .home-path {
    padding-block: 1.5rem;
    text-decoration: none;
  }

  .home-path:first-child {
    padding-right: 1.75rem;
  }

  .home-path + .home-path {
    border-left: 1px solid var(--border);
    padding-left: 1.75rem;
  }

  .home-path h2 {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-block: 0.5rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .home-path h2 span {
    color: var(--accent);
    font-size: 1rem;
  }

  .home-path p {
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .home-path:hover h2 {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 480px) {
    .home-paths {
      grid-template-columns: 1fr;
    }

    .home-path:first-child {
      padding-right: 0;
    }

    .home-path + .home-path {
      border-top: 1px solid var(--border);
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
